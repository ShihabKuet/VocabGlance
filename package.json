{
  "name": "vocabglance",
  "version": "1.0.2",
  "description": "A desktop vocabulary reminder app that periodically pops up words on screen",
  "main": "out/main/index.js",
  "author": {
    "name": "MD. SHANJID AREFIN",
    "email": "shihabkuetcse@gmail.com"
  },
  "homepage": "https://github.com/ShihabKuet/vocabglance",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.1.0",
    "eslint": "^8.57.0",
    "vite": "^5.1.4"
  },
  "build": {
    "appId": "com.vocabglance.app",
    "productName": "VocabGlance",
    "extraResources": [
      {
        "from": "resources/",
        "to": "."
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ShihabKuet",
      "repo": "VocabGlance"
    },
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VocabGlance"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    }
  }
}
